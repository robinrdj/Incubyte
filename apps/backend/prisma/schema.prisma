// Salary management data model.
// Money is stored as DECIMAL(14,2) in the local currency of the record.
// Salary history is append-only: a change inserts a new SalaryRecord and never updates an old one.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  ACTIVE
  LEAVING
}

enum AuditAction {
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  SALARY_CHANGED
}

model Country {
  id       Int    @id @default(autoincrement())
  code     String @unique @db.Char(2) // ISO 3166-1 alpha-2, e.g. "DE"
  name     String
  currency String @db.Char(3) // ISO 4217, e.g. "EUR"

  employees Employee[]
  payBands  PayBand[]
}

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[]
}

model Level {
  id   Int    @id @default(autoincrement())
  code String @unique // e.g. "L3"
  rank Int    @unique // ordering for display and band logic

  employees Employee[]
  payBands  PayBand[]
}

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  employeeCode String         @unique // human-readable, e.g. "EMP-000001"
  firstName    String
  lastName     String
  email        String         @unique
  jobTitle     String
  startDate    DateTime       @db.Date
  status       EmployeeStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  countryId    Int
  departmentId Int
  levelId      Int
  country      Country    @relation(fields: [countryId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  level        Level      @relation(fields: [levelId], references: [id])

  salaryRecords SalaryRecord[]
  auditLogs     AuditLog[]

  @@index([countryId])
  @@index([departmentId])
  @@index([levelId])
  @@index([lastName, firstName])
  @@index([status])
}

model SalaryRecord {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @db.Uuid
  amount        Decimal  @db.Decimal(14, 2)
  currency      String   @db.Char(3)
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())
  createdBy     String // actor identifier; a single HR account in v1

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom(sort: Desc)])
}

model PayBand {
  id        Int     @id @default(autoincrement())
  levelId   Int
  countryId Int
  currency  String  @db.Char(3)
  minAmount Decimal @db.Decimal(14, 2)
  maxAmount Decimal @db.Decimal(14, 2)

  level   Level   @relation(fields: [levelId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([levelId, countryId])
}

model FxRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @db.Char(3)
  toCurrency   String   @db.Char(3)
  rate         Decimal  @db.Decimal(18, 8)
  rateDate     DateTime @db.Date

  @@unique([fromCurrency, toCurrency, rateDate])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  employeeId String      @db.Uuid
  action     AuditAction
  before     Json?
  after      Json?
  actor      String
  createdAt  DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, createdAt])
}

// HR accounts that can sign in. Passwords are stored only as scrypt hashes.
model HrUser {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  createdBy    String?
  createdAt    DateTime @default(now())

  sessions Session[]
}

// A signed-in browser. Only a SHA-256 hash of the token is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime

  user HrUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
