# Copy to .env.local. Demo account shown on the sign-in page; must match the API's HR_EMAIL and HR_PASSWORD.
# Leave both empty to hide the hint (recommended for real salary data).
VITE_DEMO_EMAIL=hr.manager@acme.test
VITE_DEMO_PASSWORD=

# Where the API lives when it is hosted separately, e.g. https://salary-management-api.onrender.com
# Leave empty in development: the Vite proxy forwards /api to the local API.
VITE_API_BASE_URL=
