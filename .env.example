# Copy to .env and adjust. Never commit real credentials.
# Host ports are 5434 and 5435 to avoid clashing with a PostgreSQL install on 5432.

# Local development database (matches docker-compose.yml)
DATABASE_URL=postgres://salary:salary@localhost:5434/salary

# Separate database used by integration tests (Stage 3 onward)
TEST_DATABASE_URL=postgres://salary:salary@localhost:5435/salary_test

# The HR Manager's sign-in (HTTP Basic auth on the API). Use a long random password in production.
HR_EMAIL=hr.manager@acme.test
HR_PASSWORD=change-me-to-a-long-random-value
